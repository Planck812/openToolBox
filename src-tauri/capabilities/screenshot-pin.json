{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screenshot-pin",
  "description": "Narrow capability for bundled screenshot pin windows",
  "windows": ["pin-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging"
  ]
}
