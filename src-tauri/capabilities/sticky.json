{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sticky",
  "description": "Capability for sticky note windows",
  "windows": ["sticky-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "store:default"
  ]
}
