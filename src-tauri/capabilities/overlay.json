{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Capability for screenshot overlay windows (OCR 复制等)",
  "windows": ["overlay-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "clipboard-manager:allow-write-text"
  ]
}
